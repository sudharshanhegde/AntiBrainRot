# Dependencies
node_modules/

# Environment files. NEVER commit real secrets; only the .env.example
# templates are safe to push.
.env
!*.env.example

# Build output
dist/

# Logs
*.log
npm-debug.log*

# OS / editor noise
.DS_Store

# Pipeline generated artifacts (drafts, reviewed decks, coverage state).
# The database is the source of truth in production; these files are
# regenerated by the pipeline and must NOT be pushed.
pipeline/generated/*
!pipeline/generated/.gitkeep
pipeline/reviewed/*
!pipeline/reviewed/.gitkeep
pipeline/coverage/

# Internal reference docs. These guide development and are not part of
# the shipped product, so they stay out of the repository.
DEPLOYMENT.md
SKILL.md
SKILL_frontend.md
SKILL_pipeline.md
SKILL_topic_queue.md
