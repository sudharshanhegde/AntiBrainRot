# Port for the API
PORT=4000

# Postgres connection string. Use a local Postgres or a Supabase
# connection string.
DATABASE_URL=postgres://user:password@localhost:5432/csreels

# --- Auth ---
# Supabase project URL and anon (public) key, from the Supabase
# dashboard -> Settings -> API. Used to verify the JWTs the frontend
# sends on protected routes (progress, quiz answers, profile,
# leaderboard opt-in). The anon key is enough for token verification.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key, needed only for account deletion (DELETE
# /api/auth/me), which removes the Supabase Auth user after the app-data
# rows are gone. Keep this secret; never expose it to the frontend. If
# unset, the app-data delete still runs but the auth account removal is
# refused.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS origin for the Vite dev server
CORS_ORIGIN=http://localhost:5173

# --- LLM provider (automated generation job) ---
# Provider-agnostic and OpenAI-compatible. Point LLM_BASE_URL (or the
# legacy DEEPSEEK_BASE_URL) at any OpenAI-compatible endpoint — DeepSeek,
# Gemini's OpenAI-compat endpoint (https://generativelanguage.googleapis.com/v1beta/openai/),
# etc. Multiple keys are load-balanced across topics (~2 topics per key
# with 5 keys) so a single key never hits its rate limit. Add up to
# LLM_API_KEY_5. The code also reads legacy DEEPSEEK_API_KEY /
# GEMINI_API_KEY (and their numbered variants) as fallbacks, so you can
# keep your existing naming and just add more numbered keys.
LLM_API_KEY=your-primary-api-key
# LLM_API_KEY_2=your-second-api-key
# LLM_API_KEY_3=your-third-api-key
# LLM_API_KEY_4=your-fourth-api-key
# LLM_API_KEY_5=your-fifth-api-key
# LLM_KEY_COUNT=5
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
#
# The model is auto-detected from the base URL: Gemini endpoints default to
# gemini-3.6-flash (the model Gemini currently recommends for new projects;
# older flash models 404 with "no longer available to new users"), DeepSeek
# endpoints to deepseek-chat. Override with LLM_MODEL (highest priority) or
# GEMINI_MODEL / DEEPSEEK_MODEL:
# LLM_MODEL=gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Prefer keeping your current DEEPSEEK_API_KEY naming? Then just add the
# numbered siblings — no rename needed:
# DEEPSEEK_API_KEY=your-primary-key
# DEEPSEEK_API_KEY_2=your-second-key
# DEEPSEEK_API_KEY_3=your-third-key
# DEEPSEEK_API_KEY_4=your-fourth-key
# DEEPSEEK_API_KEY_5=your-fifth-key
# DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Automated generation endpoint (POST /api/generate) ---
# Shared secret the GitHub Actions workflow sends as:
#   Authorization: Bearer <GENERATION_SECRET>
GENERATION_SECRET=change-me-to-a-long-random-string
# Discord/Slack incoming webhook for pipeline failure alerts.
# FAILURE_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Hard cap on LLM calls per daily run (cost guardrail). With multiple API
# keys load-balanced, each deck needs ~2 calls plus a possible retry, so
# 80 comfortably covers every active topic in a single run.
DAILY_CALL_LIMIT=80
# Max decks attempted per daily run across all topics. 0 (default) = no
# cap: every active topic advances one deck per run, with the load spread
# across the configured API keys. Set a positive number to bound spend.
# DAILY_DECK_BUDGET=0
