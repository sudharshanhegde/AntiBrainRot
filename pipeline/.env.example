# DeepSeek API key (OpenAI-compatible). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional. Defaults to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat

# Optional. Defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Automated worker config ---
# Backend API where the worker publishes validated decks.
BACKEND_URL=http://localhost:4000
# How often the worker loops when run without --once (24 hours).
RUN_INTERVAL_MS=86400000
# Max decks generated per cycle (cost control).
DECK_BUDGET=5
# How many decks ahead of user progress to keep (1 = next deck is ready).
LOOKAHEAD=1
# Max generate+validate attempts per deck before giving up.
MAX_ATTEMPTS=3
