# Port for the API
PORT=4000

# Postgres connection string. Use a local Postgres or a Supabase
# connection string.
DATABASE_URL=postgres://user:password@localhost:5432/csreels

# --- Auth ---
# Supabase project URL and anon (public) key, from the Supabase
# dashboard -> Settings -> API. Used to verify the JWTs the frontend
# sends on protected routes (progress, quiz answers, profile,
# leaderboard opt-in). The anon key is enough for token verification.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key, needed only for account deletion (DELETE
# /api/auth/me), which removes the Supabase Auth user after the app-data
# rows are gone. Keep this secret; never expose it to the frontend. If
# unset, the app-data delete still runs but the auth account removal is
# refused.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS origin for the Vite dev server
CORS_ORIGIN=http://localhost:5173

# --- Automated generation endpoint (POST /api/generate) ---
# Shared secret the GitHub Actions workflow sends as:
#   Authorization: Bearer <GENERATION_SECRET>
GENERATION_SECRET=change-me-to-a-long-random-string
# Discord/Slack incoming webhook for pipeline failure alerts.
# FAILURE_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Hard cap on DeepSeek calls per daily run (cost guardrail). With one
# deck per topic per run, each topic needs ~2 calls, plus retries.
DAILY_CALL_LIMIT=30
