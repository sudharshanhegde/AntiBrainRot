# --- LLM provider (provider-agnostic, OpenAI-compatible) ---
# Works with DeepSeek, Gemini's OpenAI-compatible endpoint, or any other
# OpenAI-compatible provider by pointing LLM_BASE_URL at it. Multiple keys
# are load-balanced across topics (~2 topics per key with 5 keys) so a
# single key never hits its rate limit. Add up to LLM_API_KEY_5.
LLM_API_KEY=sk-your-primary-key-here
# LLM_API_KEY_2=sk-your-second-key-here
# LLM_API_KEY_3=sk-your-third-key-here
# LLM_API_KEY_4=sk-your-fourth-key-here
# LLM_API_KEY_5=sk-your-fifth-key-here
# LLM_KEY_COUNT=5

# Optional. Defaults to deepseek-chat.
LLM_MODEL=deepseek-chat

# Optional. Defaults to https://api.deepseek.com
# LLM_BASE_URL=https://api.deepseek.com

# Legacy single-key fallbacks (still read if the generic keys are unset):
# DEEPSEEK_API_KEY=sk-your-key-here
# GEMINI_API_KEY=...

# --- Automated worker config ---
# Backend API where the worker publishes validated decks.
BACKEND_URL=http://localhost:4000
# How often the worker loops when run without --once (24 hours).
RUN_INTERVAL_MS=86400000
# Max decks generated per cycle (cost control).
DECK_BUDGET=5
# How many decks ahead of user progress to keep (1 = next deck is ready).
LOOKAHEAD=1
# Max generate+validate attempts per deck before giving up.
MAX_ATTEMPTS=3
