# Base URL of the Express API. Defaults to http://localhost:4000.
# The frontend talks to this backend for content and progress.
VITE_API_URL=http://localhost:4000

# Supabase Auth: Google + email/password sign-in.
# Values from the Supabase dashboard -> Settings -> API. The anon key is
# public and safe to ship; the backend verifies the resulting JWTs.
# Without these the app runs but sign-in is unavailable (anonymous flow).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" to serve local placeholder decks instead of the API.
# Useful when the backend is not running.
# VITE_USE_MOCK=true

# Web Push: the VAPID public key (from `npx web-push generate-vapid-keys`
# in backend/). Required for the daily-reminder toggle to work. The key is
# public and safe to ship.
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
